# =============================================================================
# SIHL workPulse - environment configuration template
# Copy to .env and fill in real values. Never commit .env itself.
# =============================================================================

# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---- Database (Postgres) ----
# Matches the postgres service in docker-compose.yml by default.
DATABASE_URL="postgresql://workpulse:workpulse_dev_password@localhost:5432/workpulse?schema=public"

# ---- Redis / BullMQ (background jobs, SLA + escalation + recurrence engine) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (Synapse federated identity) ----
# workPulse is NOT an identity provider. It verifies the session Synapse minted
# and re-checks that the user is still active. See docs/synapse-integration.md.
#
# SESSION_SECRET must be byte-identical to Synapse's SESSION_SECRET - it is the
# HS256 key both apps sign and verify with. Rotate them together or every
# session breaks.
SESSION_SECRET=changeme-must-match-synapse

# Read-only Postgres role on Synapse's database. Grant SELECT and nothing else:
# workPulse reads user_details and user_role_map, and must never write to them.
# Without this the active-user check cannot run and every request is rejected.
SYNAPSE_DATABASE_URL="postgresql://synapse_readonly:changeme@localhost:5432/sihl_synapse?schema=public"

# Where to send unauthenticated users to sign in.
SYNAPSE_BASE_URL=http://localhost:3100

# ---- HR source (employee/org master - Section 4.2 of the BRS) ----
# workPulse does NOT duplicate the employee master; it caches a read copy.
# HR_SOURCE=synapse (default since 2026-10-07): read Synapse's HR data (Spine HR in
#   hr_employee, plus Synapse users with an employee code) over SYNAPSE_DATABASE_URL.
#   The read-only role needs SELECT on hr_employee as well as user_details.
# HR_SOURCE=frappe: read Frappe HR as below.
HR_SOURCE=synapse

# ---- Frappe HR (only when HR_SOURCE=frappe) ----
# Leave FRAPPE_SYNC_MODE=mock until real credentials are available - the sync
# job will generate realistic fixture data instead of calling out to Frappe,
# so the rest of the app can be built and tested against it immediately.
FRAPPE_BASE_URL=https://sihl-frappe-instance.example.com
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_SYNC_MODE=mock

# Local dev only (HR_SOURCE=frappe, mock mode). Employees link to Synapse users
# by EMPLOYEE CODE; the mock fixture codes (EMP-0001...) match nobody in a real
# Synapse, so your own tasks and desk card would always be empty. Set this to
# your Synapse user's employee code to re-point the first fixture employee at you.
FRAPPE_MOCK_LINK_CODE=
FRAPPE_SYNC_CRON="0 */2 * * *"

# ---- Object storage (S3-compatible; attachments) ----
# Point at a local MinIO for dev (see docker-compose.yml), swap for real AWS S3
# credentials + bucket in staging/prod via infra-level secrets, not this file.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=workpulse-dev
S3_ACCESS_KEY_ID=workpulse
S3_SECRET_ACCESS_KEY=workpulse_dev_password

# ---- chat-hub integration (read-only targeted-chat access point) ----
# Optional: absent or unreachable chat-hub fails quietly (empty conversation
# list), never a 500 - see ChatHubClient. CHAT_HUB_SERVICE_SECRET must match
# chat-hub's own CHAT_HUB_SERVICE_SECRET exactly (it authenticates workPulse
# to chat-hub as a trusted service caller, not a per-user credential).
CHAT_HUB_BASE_URL=
CHAT_HUB_SERVICE_SECRET=

# ---- Observability ----
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Dictation (Sarvam AI)
# -----------------------------------------------------------------------------
# Lets staff dictate a task note instead of typing it. Off by default: with no
# key the microphone hides itself rather than offering a control that fails.
#
# Sarvam is the same provider SIHL-ONE uses, and for the same reason - an Indian
# provider, so a recording of somebody discussing a named client stays with an
# Indian company. speech-to-text-translate accepts the languages staff actually
# speak and returns English, so a note is readable by whoever picks it up.
#
# Billed per second of audio. The ten-second cap in the UI and the 5 MB limit on
# the controller are what keep a note costing fractions of a rupee.
SPEECH_PROVIDER=none
# SPEECH_PROVIDER=sarvam
# SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text-translate
SPEECH_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Attachments
# -----------------------------------------------------------------------------
# Where uploaded files are written. Content-addressed by SHA-256, so the same
# file attached to forty tasks is stored once and nothing is ever overwritten.
#
# A relative path resolves against the API's working directory; set an absolute
# one in production, on a volume that is backed up. Evidence attached to a
# closed task is part of the record SEBI may ask about - losing this directory
# loses the files, though the rows and the audit trail survive in the database.
ATTACHMENT_DIR=./storage/attachments
