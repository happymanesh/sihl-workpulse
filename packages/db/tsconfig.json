{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  // prisma/seed.ts is deliberately excluded: it is executed with tsx, never
  // imported, and including it would push the emitted output down an extra
  // directory level (dist/src/... instead of dist/...).
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
